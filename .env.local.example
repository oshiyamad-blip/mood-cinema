# TMDB API v3 — Read Access Token (Bearer)
# https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=

# Amazon associate tag (例: yourname-22)
VITE_AMAZON_TAG=

# A8.net 経由 U-NEXT アフィリ用パラメータ
# 提携承認後に発行されるリダイレクト URL のテンプレート
# 例: https://px.a8.net/svt/ejp?a8mat=XXXXX&a8ejpredirect=
VITE_UNEXT_REDIRECT_PREFIX=

# AdSense Publisher ID (取得後)
VITE_ADSENSE_CLIENT=

# サイト公開 URL (OGP / sitemap 用)
VITE_SITE_URL=https://mood-cinema.example.com

# ── アカウント同期（任意）── 未設定ならログイン導線ごと非表示に縮退する
# Supabase プロジェクトの Project URL と anon public key（公開可・service_role は入れない）
# Project Settings → API から取得
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

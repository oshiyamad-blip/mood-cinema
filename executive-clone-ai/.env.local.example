# ─── Claude API ───────────────────────────────────────────────────
# Anthropic API キー。https://console.anthropic.com で取得。
# データ学習除外の API エンドポイントを使用すること。
ANTHROPIC_API_KEY=

# 使用モデル（省略時は claude-opus-4-8）
CLAUDE_MODEL=claude-opus-4-8

# ─── Notion ───────────────────────────────────────────────────────
# Notion Integration Token。https://www.notion.so/my-integrations で取得。
NOTION_API_KEY=

# 各データベースの ID（URL の 32 桁英数字部分）
NOTION_SIGNAL_DB_ID=
NOTION_STORY_DB_ID=
NOTION_DECISION_RULE_DB_ID=

# ─── Google Workspace ─────────────────────────────────────────────
# OAuth 2.0 クライアント情報（Google Cloud Console で作成）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Slack ────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
# 収集対象チャンネル ID をカンマ区切りで列挙
SLACK_CHANNEL_IDS=

# ─── アクセス制御 ─────────────────────────────────────────────────
# 対話インターフェースにアクセス可能なメールアドレス（カンマ区切り）
ALLOWED_EMAILS=

# 内部 API 呼び出し用シークレット（バッチスクリプト → API Route 認証）
INTERNAL_API_SECRET=

# ─── 音声ライフログ ────────────────────────────────────────────────
# Whisper API（音声→テキスト変換）。ANTHROPIC と同じキーで利用する場合は空でよい
OPENAI_API_KEY=

# ─── サイト設定 ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
